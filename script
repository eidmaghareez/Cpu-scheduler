# ==================== MAIN LOOP ====================
results = []
for i, url in enumerate(urls, 1):
    place_name = unquote(url.split("query=")[-1].replace("+", " "))
    print(f"[{i}/92] Processing: {place_name[:80]}...")
    
    driver.get(url)
    time.sleep(30)                    # 30 seconds wait for Google Maps JS to update the URL
    
    current_url = driver.current_url
    
    # Extract coordinates
    match = re.search(r'@(-?\d+\.\d+),(-?\d+\.\d+)', current_url)
    if not match:
        match = re.search(r'!3d(-?\d+\.\d+)!4d(-?\d+\.\d+)', current_url)
    
    if match:
        lat, lng = match.groups()
    else:
        lat = lng = "NOT_FOUND"
    
    results.append({
        "original_query": place_name,
        "latitude": lat,
        "longitude": lng,
        "full_url": current_url
    })
    
    print(f"   → {lat}, {lng}")

driver.quit()

# ==================== SAVE TO CSV ====================
with open("bank_al_etihad_coordinates.csv", "w", newline="", encoding="utf-8") as f:
    writer = csv.DictWriter(f, fieldnames=["original_query", "latitude", "longitude", "full_url"])
    writer.writeheader()
    writer.writerows(results)

print("\n✅ DONE! All coordinates saved to bank_al_etihad_coordinates.csv")
